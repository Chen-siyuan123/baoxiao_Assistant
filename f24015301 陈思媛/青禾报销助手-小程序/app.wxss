/* ============================================================
   青禾报销助手 · 全局样式
   主色：青禾绿 #1F8A70
   ============================================================ */

page {
  background: #F2F6F5;
  color: #1C2B28;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
}

/* ---------- 布局 ---------- */
.page-body {
  padding: 24rpx 28rpx 180rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.row-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

.gap-8 { gap: 8rpx; }
.gap-12 { gap: 12rpx; }
.gap-16 { gap: 16rpx; }
.gap-20 { gap: 20rpx; }

.mt-8 { margin-top: 8rpx; }
.mt-12 { margin-top: 12rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-28 { margin-top: 28rpx; }
.mt-36 { margin-top: 36rpx; }

/* ---------- 文字 ---------- */
.t-xs { font-size: 22rpx; }
.t-sm { font-size: 24rpx; }
.t-md { font-size: 28rpx; }
.t-lg { font-size: 32rpx; }
.t-xl { font-size: 38rpx; }
.t-xxl { font-size: 46rpx; }

.t-bold { font-weight: 600; }
.t-heavy { font-weight: 700; }

.t-muted { color: #7C8D89; }
.t-sub { color: #566763; }
.t-main { color: #1C2B28; }
.t-brand { color: #1F8A70; }
.t-warn { color: #C1701A; }
.t-danger { color: #C0392B; }

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.clamp-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.clamp-3 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.pre-wrap {
  white-space: pre-wrap;
  word-break: break-word;
}

/* ---------- 卡片 ---------- */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(31, 138, 112, 0.06);
  box-sizing: border-box;
}

.card-tight {
  padding: 20rpx 24rpx;
}

.card-flat {
  box-shadow: none;
  border: 2rpx solid #E4EBE9;
}

.card-press {
  transform: scale(0.985);
  transition: transform 0.12s ease;
  opacity: 0.95;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #1C2B28;
  margin: 36rpx 0 18rpx;
}

.section-title::before {
  content: "";
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: #1F8A70;
  margin-right: 14rpx;
}

.section-title .sub {
  font-size: 22rpx;
  font-weight: 400;
  color: #8A9A96;
  margin-left: 12rpx;
}

/* ---------- 徽标 / 标签 ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 100rpx;
  font-size: 21rpx;
  line-height: 1.5;
  font-weight: 500;
}

.tag-brand { background: #E3F2EE; color: #1F8A70; }
.tag-grey  { background: #EEF2F1; color: #6B7B77; }
.tag-warn  { background: #FDF3E4; color: #C1701A; }
.tag-info  { background: #E9EFF9; color: #3C63A8; }
.tag-plum  { background: #F0EBF8; color: #6B4FA8; }
.tag-danger{ background: #FBEBE8; color: #C0392B; }
.tag-green { background: #E4F3E9; color: #2E7D4F; }

/* ---------- 按钮 ---------- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.btn-primary {
  background: #1F8A70;
  color: #FFFFFF;
}

.btn-primary-plain {
  background: #E3F2EE;
  color: #1F8A70;
}

.btn-ghost {
  background: #FFFFFF;
  color: #1F8A70;
  border: 2rpx solid #BEDDD4;
}

.btn-quiet {
  background: #F0F4F3;
  color: #566763;
}

.btn:active {
  opacity: 0.85;
}

.btn-sm {
  height: 64rpx;
  font-size: 26rpx;
  border-radius: 16rpx;
  padding: 0 26rpx;
}

.btn[disabled],
.btn.disabled {
  opacity: 0.45;
}

/* ---------- 输入 ---------- */
.input {
  background: #F5F8F7;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #1C2B28;
  box-sizing: border-box;
  width: 100%;
}

.input-placeholder {
  color: #A6B4B0;
}

.field-label {
  font-size: 26rpx;
  color: #566763;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.field-required::after {
  content: " *";
  color: #C0392B;
}

.picker-box {
  background: #F5F8F7;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  color: #1C2B28;
}

/* ---------- 列表行 ---------- */
.list-row {
  display: flex;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #F0F4F3;
}

.list-row:last-child {
  border-bottom: none;
}

.chev {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #B6C3C0;
  border-right: 3rpx solid #B6C3C0;
  transform: rotate(45deg);
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 90rpx 40rpx;
  text-align: center;
}

.empty-title {
  font-size: 30rpx;
  color: #566763;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 25rpx;
  color: #8A9A96;
  line-height: 1.7;
}

/* ---------- 提示条 ---------- */
.notice {
  display: flex;
  gap: 16rpx;
  background: #F4F8F7;
  border-left: 8rpx solid #1F8A70;
  border-radius: 12rpx;
  padding: 20rpx 22rpx;
  font-size: 24rpx;
  color: #4E5F5B;
  line-height: 1.7;
}

.notice-warn {
  background: #FDF7EE;
  border-left-color: #D89A3C;
}

.notice-info {
  background: #EEF3FB;
  border-left-color: #6C8CC4;
}

.notice-icon {
  flex-shrink: 0;
  font-weight: 700;
  color: #1F8A70;
}

.notice-warn .notice-icon { color: #D89A3C; }
.notice-info .notice-icon { color: #6C8CC4; }

/* ---------- 顶部渐变头 ---------- */
.hero {
  background: linear-gradient(160deg, #1F8A70 0%, #2AA383 55%, #35B08D 100%);
  padding: 40rpx 32rpx 84rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}

.hero::after {
  content: "";
  position: absolute;
  right: -120rpx;
  top: -140rpx;
  width: 380rpx;
  height: 380rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.07);
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-sub {
  font-size: 25rpx;
  color: rgba(255, 255, 255, 0.82);
  margin-top: 10rpx;
}

.hero-pull {
  margin-top: -60rpx;
  position: relative;
  z-index: 2;
}

/* ---------- 搜索框 ---------- */
.search-bar {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 6rpx 24rpx rgba(20, 60, 50, 0.10);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  margin-left: 14rpx;
}

/* ---------- 网格入口 ---------- */
.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 22rpx 6rpx;
  box-sizing: border-box;
}

.grid-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-bottom: 12rpx;
}

.grid-text {
  font-size: 23rpx;
  color: #3D4D49;
  text-align: center;
}

/* ---------- 进度时间轴 ---------- */
.timeline {
  padding-left: 10rpx;
}

.tl-item {
  display: flex;
  gap: 20rpx;
  position: relative;
}

.tl-rail {
  width: 34rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tl-dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #D5DEDC;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.tl-dot.on {
  background: #1F8A70;
  box-shadow: 0 0 0 8rpx rgba(31, 138, 112, 0.14);
}

.tl-line {
  flex: 1;
  width: 3rpx;
  background: #E3EBE9;
  margin: 8rpx 0;
}

.tl-body {
  flex: 1;
  padding-bottom: 34rpx;
  min-width: 0;
}

/* ---------- 底部操作条 ---------- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(20, 60, 50, 0.06);
  display: flex;
  gap: 20rpx;
  z-index: 20;
}

/* ---------- 弹层 ---------- */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(16, 32, 28, 0.5);
  z-index: 100;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  z-index: 101;
  max-height: 88vh;
  display: flex;
  flex-direction: column;
}

.sheet-head {
  padding: 34rpx 32rpx 20rpx;
  border-bottom: 2rpx solid #F0F4F3;
}

.sheet-body {
  padding: 28rpx 32rpx;
  overflow-y: auto;
  flex: 1;
}

.sheet-foot {
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #F0F4F3;
  display: flex;
  gap: 20rpx;
}

/* ---------- 分割线 ---------- */
.divider {
  height: 2rpx;
  background: #EFF3F2;
  margin: 24rpx 0;
}

.dashed-divider {
  height: 0;
  border-top: 2rpx dashed #DDE5E3;
  margin: 26rpx 0;
}

/* ---------- 金额 ---------- */
.amount {
  font-family: "DIN Alternate", "SF Pro Display", -apple-system, sans-serif;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

/* ---------- 通用：标签换行 / 底部留白 ---------- */
.tags-wrap {
  flex-wrap: wrap;
  align-items: flex-start;
}

.pb-bar {
  padding-bottom: 200rpx;
}

/* ---------- 通用：热门问题行 ---------- */
.hot-q {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #F0F4F3;
}

.hot-q:last-child {
  border-bottom: none;
}

.hot-q-mark {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  background: #E3F2EE;
  color: #1F8A70;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* ---------- 通用：圆形头像字 ---------- */
.avatar-round {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #E3F2EE;
  color: #1F8A70;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-round-plum {
  background: #F0EBF8;
  color: #6B4FA8;
}

.avatar-round-blue {
  background: #E9EFF9;
  color: #3C63A8;
}

