.fin-head {
  background: linear-gradient(160deg, #4B3B78 0%, #6B4FA8 60%, #7D63B8 100%);
  padding: 40rpx 32rpx 36rpx;
  color: #FFFFFF;
}

.fin-stats {
  display: flex;
  align-items: stretch;
  margin-top: 30rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 20rpx;
  padding: 22rpx 10rpx;
}

.fin-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.fin-stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
}

.fin-stat-label {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 6rpx;
}

.fin-stat-divider {
  width: 2rpx;
  background: rgba(255, 255, 255, 0.22);
  margin: 6rpx 0;
}

/* ---------- 筛选 ---------- */
.filter-wrap {
  background: #FFFFFF;
  padding: 20rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(20, 60, 50, 0.05);
}

.chips {
  white-space: nowrap;
  display: flex;
}

.chip {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  padding: 10rpx 26rpx;
  border-radius: 100rpx;
  background: #F2F6F5;
  color: #566763;
  font-size: 24rpx;
  margin-right: 14rpx;
}

.chip-on {
  background: #6B4FA8;
  color: #FFFFFF;
  font-weight: 500;
}

/* ---------- 单据条目 ---------- */
.fin-item {
  margin-top: 20rpx;
  border-left: 8rpx solid #EDE7F7;
}

.fin-amount {
  font-size: 40rpx;
  color: #1C2B28;
}

.act-row {
  flex-wrap: wrap;
}

.act-btn {
  font-size: 24rpx;
  color: #4E5F5B;
  background: #F0F4F3;
  border-radius: 100rpx;
  padding: 12rpx 28rpx;
}

.act-btn:active {
  opacity: 0.8;
}

.act-primary {
  color: #FFFFFF;
  background: #6B4FA8;
}

/* ---------- 核对要点 ---------- */
.hint-card {
  margin-top: 16rpx;
  border-left: 8rpx solid #C9B8E8;
}

.check-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #F0F4F3;
}

.check-row:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border-radius: 12rpx;
  border: 3rpx solid #CBD6D3;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  flex-shrink: 0;
  margin-top: 2rpx;
  box-sizing: border-box;
}

.checkbox-on {
  background: #6B4FA8;
  border-color: #6B4FA8;
}

/* ---------- 表单 ---------- */
.textarea {
  min-height: 150rpx;
  line-height: 1.7;
  width: 100%;
}

.foot-note {
  font-size: 22rpx;
  color: #9AA8A4;
  line-height: 1.75;
  padding: 40rpx 20rpx 20rpx;
}
