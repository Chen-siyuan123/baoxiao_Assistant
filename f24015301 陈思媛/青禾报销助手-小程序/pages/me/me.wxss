.me-head {
  background: linear-gradient(160deg, #1F8A70 0%, #2AA383 100%);
  padding: 44rpx 32rpx 48rpx;
  color: #FFFFFF;
}

.me-avatar {
  width: 108rpx;
  height: 108rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.32);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  flex-shrink: 0;
  overflow: hidden;
}

.me-head .t-xl {
  color: #FFFFFF;
}

.me-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
  margin-top: 10rpx;
}

.me-edit {
  font-size: 24rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 100rpx;
  padding: 8rpx 26rpx;
  flex-shrink: 0;
}

.me-roledesc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  line-height: 1.7;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.18);
}

.tag-white {
  background: rgba(255, 255, 255, 0.22);
  color: #FFFFFF;
}

/* ---------- 统计 ---------- */
.stat-row {
  align-items: stretch;
}

.stat-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 0;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #1C2B28;
  line-height: 1.3;
}

.stat-label {
  font-size: 22rpx;
  color: #8A9A96;
  margin-top: 8rpx;
}

.stat-divider {
  width: 2rpx;
  background: #EFF3F2;
  margin: 6rpx 0;
}

/* ---------- 职责入口 ---------- */
.duty-badge {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.db-green { background: #E3F2EE; color: #1F8A70; }
.db-plum  { background: #F0EBF8; color: #6B4FA8; }

.ml-16 {
  margin-left: 16rpx;
}
