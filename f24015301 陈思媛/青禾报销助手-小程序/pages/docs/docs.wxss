.docs-head {
  background: linear-gradient(160deg, #1F8A70 0%, #2AA383 100%);
  padding: 36rpx 32rpx 34rpx;
  color: #FFFFFF;
}

.auth-chip {
  font-size: 24rpx;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  border-radius: 100rpx;
  padding: 8rpx 24rpx;
  flex-shrink: 0;
}

.stat-strip {
  display: flex;
  align-items: stretch;
  margin-top: 32rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 20rpx;
  padding: 22rpx 10rpx;
}

.strip-cell {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.strip-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
}

.strip-amount {
  font-size: 30rpx;
  font-family: "DIN Alternate", -apple-system, sans-serif;
}

.strip-label {
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 6rpx;
}

.strip-divider {
  width: 2rpx;
  background: rgba(255, 255, 255, 0.22);
  margin: 6rpx 0;
}

/* ---------- 筛选 ---------- */
.filter-wrap {
  background: #FFFFFF;
  padding: 20rpx 28rpx;
}

.docs-filter {
  box-shadow: 0 4rpx 16rpx rgba(20, 60, 50, 0.05);
}

.chips {
  white-space: nowrap;
  display: flex;
}

.chip {
  display: inline-flex;
  align-items: center;
  flex-shrink: 0;
  padding: 10rpx 26rpx;
  border-radius: 100rpx;
  background: #F2F6F5;
  color: #566763;
  font-size: 24rpx;
  margin-right: 14rpx;
}

.chip-on {
  background: #1F8A70;
  color: #FFFFFF;
  font-weight: 500;
}

/* ---------- 单据卡 ---------- */
.doc-card {
  margin-top: 20rpx;
}

.doc-amount {
  font-size: 40rpx;
  color: #1C2B28;
}

.fact-ok {
  font-size: 21rpx;
  color: #2E7D4F;
}

.fact-wait {
  font-size: 21rpx;
  color: #C1701A;
}

/* ---------- 空状态按钮 ---------- */
.empty-btn {
  display: inline-flex;
  margin-top: 26rpx;
  padding: 0 40rpx;
}

.foot-note {
  font-size: 22rpx;
  color: #9AA8A4;
  line-height: 1.75;
  padding: 40rpx 20rpx 20rpx;
}

/* ---------- 授权清单 ---------- */
.consent-block {
  margin-bottom: 28rpx;
}

.consent-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #566763;
  margin-bottom: 14rpx;
}

.consent-item {
  display: flex;
  gap: 14rpx;
  align-items: flex-start;
  padding: 12rpx 0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-top: 14rpx;
  flex-shrink: 0;
}

.dot-green {
  background: #1F8A70;
}

.dot-grey {
  background: #B6C3C0;
}
