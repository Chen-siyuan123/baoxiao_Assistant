.dd-head {
  background: linear-gradient(160deg, #1F8A70 0%, #2AA383 100%);
  padding: 36rpx 32rpx 40rpx;
  color: #FFFFFF;
}

.tag-white {
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
}

.dd-amount {
  font-size: 66rpx;
  color: #FFFFFF;
  margin-top: 20rpx;
  line-height: 1.15;
}

.dd-hint {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}

/* ---------- 核对卡 ---------- */
.verify-card {
  border-left: 8rpx solid #E0E7E5;
}

.vc-ok {
  border-left-color: #6B4FA8;
}

.vc-wait {
  border-left-color: #D89A3C;
}

/* ---------- 键值行 ---------- */
.kv-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #F0F4F3;
}

.kv-row-last {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.kv-label {
  width: 150rpx;
  flex-shrink: 0;
  font-size: 25rpx;
  color: #8A9A96;
}

.kv-value {
  flex: 1;
  font-size: 27rpx;
  color: #1C2B28;
  text-align: right;
  word-break: break-all;
}

.kv-reason {
  text-align: left;
  line-height: 1.7;
  font-size: 26rpx;
  color: #3D4D49;
}

.mini-action {
  font-size: 23rpx;
  color: #1F8A70;
  background: #EAF5F1;
  border-radius: 100rpx;
  padding: 6rpx 20rpx;
  flex-shrink: 0;
}

.foot-note {
  font-size: 22rpx;
  color: #9AA8A4;
  line-height: 1.75;
  padding: 40rpx 20rpx 20rpx;
}
